# 原始比赛数据（GitHub 单文件限 100MB，需要时从 Kaggle 重新下载）
**/data/
*.zip

# 模型权重 / oof 资产（超大）
smartphone_addiction/oof/
smartphone_addiction/public_oof/

# Python 缓存
__pycache__/
*.py[cod]

# 运行日志 / 临时文件
*.log
*.tmp
catboost_info/

# kernel 运行产物（大体积 npy / 中间输出；提交 CSV 仍在各赛 submissions/）
**/_out/
**/_out_*/

# Kaggle / 环境
kaggle.json
.credentials

# 活跃奖牌赛（赛期内不公开，赛后才归档）
# kaggriculture（截止 2026-09-24）与 rsna_knee（截止 2026-10-22）已于 2026-10-30 赛后归档
/gemma4_agent/

# 归档赛的体量排除（代码/文档/复盘进仓库，数据/权重/trace 不进）
/kaggriculture/_external/
/kaggriculture/_archive/large_traces/
/rsna_knee/_dataset_stage/
/rsna_knee/_torch_dataset/

# gemma4_agent 仍在活跃（论文赛道 2026-11-12 截止），其根级产物与暂存不公开
/out6/
/out7/
/_ds_stage/

# 浏览器自动化缓存
/.playwright-cli/

# 跨赛临时 / 研究扫描（不进公开仓）
/_top_replay_agent/
/.firecrawl/

# 根目录禁止再出现提交泄漏
/main.py
/submission.py
/submission.csv
/submission.tar
/submission.tar.gz
/actions.json
/kaggriculture-*.py

# Agent 配置（含记忆）
/.atomcode/
/.agent-memory/

# 赛中运营索引 / 工作区日志（含活跃奖牌赛细节，不进公开仓）
/COMPETITIONS.md
/_workspace/
