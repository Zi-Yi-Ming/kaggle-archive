      "source": [
        "# EXP-013/014 Colab 训练（免费 T4）\n",
        "\n",
        "目标：在 Colab Free GPU 上训练多源标签模型，保存 `model.pt`，再传回 Kaggle Dataset 供薄推理提交。\n",
        "\n",
        "1. 先挂 T4（代码执行程序 → 更改运行时类型）\n",
        "2. 上传 `kaggle.json` 或粘贴 API\n",
        "3. 按顺序跑单元格\n",
        "4. 训完把 `model.pt` 从左侧文件栏下载，或跑最后一格自动传 Dataset"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import os, subprocess, sys\n",
        "from pathlib import Path\n",
        "\n",
        "assert torch_gpu() if False else True\n",
        "import torch\n",
        "print('torch', torch.__version__, 'cuda', torch.cuda.is_available())\n",
        "if torch.cuda.is_available():\n",
        "    print('GPU', torch.cuda.get_device_name(0),\n",
        "          f'{torch.cuda.get_device_properties(0).total_memory/1e9:.1f}GB')\n",
        "else:\n",
        "    raise RuntimeError('No GPU — 代码执行程序 → 更改运行时类型 → GPU (T4)')\n",
        "\n",
        "!pip -q install pydicom scikit-learn pandas numpy pillow kaggle\n",
        "print('deps ok')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# === Kaggle 凭证：二选一 ===\n",
        "from pathlib import Path\n",
        "import os, json\n",
        "\n",
        "kjson = Path('/content/kaggle.json')\n",
        "if kjson.exists():\n",
        "    os.environ['KAGGLE_CONFIG_DIR'] = '/content'\n",
        "    print('use /content/kaggle.json')\n",
        "else:\n",
        "    # 在这里粘贴 {"username":"...","key":"..."} 或先上传 kaggle.json\n",
        "    CRED = r'''{\"username\":\"\",\"key\":\"\"}'''\n",
        "    if '\"key\"' in CRED and CRED.strip().endswith('}'):\n",
        "        try:\n",
        "            json.loads(CRED)\n",
        "            Path('/root/.kaggle').mkdir(parents=True, exist_ok=True)\n",
        "            Path('/root/.kaggle/kaggle.json').write_text(CRED)\n",
        "            os.chmod('/root/.kaggle/kaggle.json', 0o600)\n",
        "            os.environ['KAGGLE_CONFIG_DIR'] = '/root/.kaggle'\n",
        "            print('wrote /root/.kaggle/kaggle.json')\n",
        "        except Exception as e:\n",
        "            print('CRED parse fail', e)\n",
        "    else:\n",
        "        print('请上传 kaggle.json 或填写 CRED')\n",
        "\n",
        "!kaggle competitions files -c rsna-knee-abnormality-detection | head"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# === 拉数据 + 标签 ===\n",
        "import os, zipfile, glob\n",
        "from pathlib import Path\n",
        "\n",
        "ROOT = Path('/content/rsna_knee')\n",
        "ROOT.mkdir(exist_ok=True)\n",
        "os.chdir(ROOT)\n",
        "\n",
        "# 比赛数据（train.csv / DICOM 很大；Colab 盘约 70-100GB，够放 train 子集）\n",
        "# 若只训标签表 + 已有 DICOM 缓存，可跳过 DICOM\n",
        "if not (ROOT/'train.csv').exists():\n",
        "    !kaggle competitions download -c rsna-knee-abnormality-detection -f train.csv -p .\n",
        "    !kaggle competitions download -c rsna-knee-abnormality-detection -f train_series.csv -p .\n",
        "    for f in glob.glob('*.zip'):\n",
        "        zipfile.ZipFile(f).extractall('.')\n",
        "print('train.csv', (ROOT/'train.csv').exists(), 'size', (ROOT/'train.csv').stat().st_size if (ROOT/'train.csv').exists() else 0)\n",
        "\n",
        "# 标签\n",
        "LAB = ROOT/'_llm'\n",
        "LAB.mkdir(exist_ok=True)\n",
        "if not (LAB/'llm_labels_v4_blend.csv').exists():\n",
        "    !kaggle datasets download -d stevenleehans/rsna-knee-llm-report-labels -p $LAB --unzip\n",
        "if not (LAB/'labels_llm_gpt56sol.csv').exists():\n",
        "    !kaggle datasets download -d lixin73/rsna-knee-llm-report-labels-sol56 -p $LAB --unzip\n",
        "if not list(LAB.glob('*report_labels_v2.csv')):\n",
        "    !kaggle datasets download -d pilkwang/rsna-knee-llm-labels -p $LAB --unzip\n",
        "print('labels', list(LAB.glob('*.csv'))[:10])"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# === 训练代码（EXP-013 多源 + 置信加权）===\n",
        "from pathlib import Path\n",
        "import urllib.request\n",
        "\n",
        "WORK = Path('/content/work')\n",
        "WORK.mkdir(exist_ok=True)\n",
        "\n",
        "# 从已上传的 Kernel 拉 rsna_v3 / exp013（或手动上传）\n",
        "for src, dst in [\n",
        "    (f'{WORK}/rsna_v3.py', 'rsna_v3.py'),\n",
        "    (f'{WORK}/exp013_multisource.py', 'exp013_multisource.py'),\n",
        "]:\n",
        "    print(dst, Path(src).exists() or Path(dst).exists())\n",
        "\n",
        "print('把 rsna_v3.py 和 exp013_multisource.py 上传到 /content/work/ 后再跑下一格')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# === 开训：Axial 快刀（2-3h）或 S+C+A（约 7h，T4 可能要拆）===\n",
        "import os, subprocess, sys\n",
        "from pathlib import Path\n",
        "\n",
        "os.chdir('/content/work')\n",
        "os.environ['EXP013_MULTISOURCE'] = '1'\n",
        "os.environ['EXP013_LABEL_ROOT'] = '/content/rsna_knee/_llm'\n",
        "\n",
        "PLANES = 'axial'  # 改成 'sagittal,coronal,axial' 跑全家桶\n",
        "NCLIPS = 4\n",
        "EXP_ID = 'exp_013_colab_axial'\n",
        "\n",
        "cmd = [sys.executable, '-u', 'rsna_v3.py',\n",
        "       '--planes', PLANES,\n",
        "       '--epochs', '3', '--folds', '5', '--only-fold', '0',\n",
        "       '--batch', '8', '--n-clips', str(NCLIPS),\n",
        "       '--experiment-id', EXP_ID, '--verbose']\n",
        "print('RUN', ' '.join(cmd), flush=True)\n",
        "r = subprocess.run(cmd)\n",
        "print('returncode', r.returncode, flush=True)\n",
        "\n",
        "art = Path(f'artifacts/{EXP_ID}/fold0')\n",
        "print('weights:', list(art.rglob('model.pt')))"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# === 打包权重，传 Kaggle Dataset（扁平 Axial/model.pt）===\n",
        "import os, shutil, json, glob\n",
        "from pathlib import Path\n",
        "\n",
        "stage = Path('/content/exp013_colab_weights')\n",
        "if stage.exists(): shutil.rmtree(stage)\n",
        "stage.mkdir()\n",
        "\n",
        "for plane in ['Sagittal', 'Coronal', 'Axial']:\n",
        "    src = Path(f'artifacts/{EXP_ID}/fold0/{plane}/model.pt')\n",
        "    if not src.exists():\n",
        "        src = Path(f'artifacts/{EXP_ID}/fold0/model.pt')  # 单平面\n",
        "    if src.exists():\n",
        "        d = stage/plane\n",
        "        d.mkdir(exist_ok=True)\n",
        "        shutil.copy(src, d/'model.pt')\n",
        "        print('staged', plane, src.stat().st_size)\n",
        "\n",
        "(stage/'dataset-metadata.json').write_text(json.dumps({\n",
        "    'title': 'RSNA EXP013 Colab weights',\n",
        "    'id': 'ziyiming/rsna-exp013-colab-weights',\n",
        "    'licenses': [{'name': 'CC0-1.0'}]\n",
        "}, indent=2))\n",
        "\n",
        "print('stage ready', list(stage.rglob('*.pt')))\n",
        "print('传 Dataset：')\n",
        "print('  !kaggle datasets create -p /content/exp013_colab_weights -u --dir-mode zip')\n",
        "print('  # 若已存在：')\n",
        "print('  !kaggle datasets version -p /content/exp013_colab_weights -m colab-weights -r zip')"
      ],
      "execution_count": null,
      "outputs": []
    }
  ]
